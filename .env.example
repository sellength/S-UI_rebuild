# S-UI Distributed Preview server environment
#
# Copy this file to .env before starting docker-compose.yml:
#   cp .env.example .env
#
# Never commit the real .env file.

TZ=Asia/Shanghai

# Docker images used by docker-compose.yml.
SUI_IMAGE=sellength/s-ui_dev:latest
SUI_SINGBOX_IMAGE=sellength/s-ui_rebuild-singbox:latest

# PostgreSQL is bound to 127.0.0.1 only by docker-compose.yml.
SUI_POSTGRES_PORT=54329
SUI_POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password

# Used to encrypt DNS Provider credentials, certificate PEM and private keys.
# Production value must be a long random string and must be backed up.
SUI_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars

# Shared bootstrap token used by remote Agents during registration.
SUI_AGENT_REGISTER_TOKEN=replace-with-a-long-random-agent-register-token

# Public panel URL used in docs/scripts. docker-compose.yml does not read it
# directly, but keeping it here avoids copying the wrong Agent URL.
SUI_PANEL_DOMAIN=https://panel.example.com
