FROM node:24-alpine AS frontend

WORKDIR /src/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM golang:1.25-alpine AS backend

WORKDIR /src
RUN apk add --no-cache git
COPY backend/go.mod backend/go.sum ./backend/
WORKDIR /src/backend
RUN go mod download
WORKDIR /src
COPY backend ./backend
COPY --from=frontend /src/frontend/dist ./frontend/dist
RUN rm -rf backend/web/html/* && cp -R frontend/dist/* backend/web/html/
WORKDIR /src/backend
RUN go mod download && go build -tags postgres -o /out/sui main.go

FROM alpine:3.22

RUN apk add --no-cache ca-certificates tzdata curl bash openssl git
ENV TZ=Asia/Shanghai
ENV SUI_ACME_SH=/usr/local/s-ui/acme/acme.sh
ENV SUI_ACME_HOME=/usr/local/s-ui/acme
ENV SUI_CERTIFICATE_WORK_DIR=/usr/local/s-ui/certificates

RUN git clone --depth 1 https://github.com/acmesh-official/acme.sh.git /usr/local/s-ui/acme \
    && chmod +x /usr/local/s-ui/acme/acme.sh

WORKDIR /usr/local/s-ui
COPY --from=backend /out/sui /usr/local/s-ui/sui

RUN mkdir -p /usr/local/s-ui/db /usr/local/s-ui/bin /usr/local/s-ui/cert /usr/local/s-ui/certificates \
    && chmod +x /usr/local/s-ui/sui

COPY core/runSingbox.sh /usr/local/s-ui/bin/runSingbox.sh
COPY core/sing-box /usr/local/s-ui/bin/sing-box

RUN chmod +x /usr/local/s-ui/bin/runSingbox.sh \
    && if [ -f /usr/local/s-ui/bin/sing-box ]; then chmod +x /usr/local/s-ui/bin/sing-box; fi

EXPOSE 2095 2096

CMD ["/bin/sh", "-c", "/usr/local/s-ui/sui migrate && /usr/local/s-ui/sui"]
